{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaudeAutoContinue",
  "version": "1.3.0",
  "identifier": "com.claudeautocontinue.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Claude 自动续跑监听器",
        "width": 980,
        "height": 860,
        "minWidth": 860,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Claude Auto Continue",
    "category": "DeveloperTool",
    "shortDescription": "Claude Code 断点续跑监听器",
    "longDescription": "监听 ~/.claude 会话记录，发现输出截断或明确未完成后，自动向 Claude Code（VS Code 插件）或 Claude CLI（终端）发送续跑提示词。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/pengge499896694/claude-auto-continue/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEOTcxRjVGODVGRjI4M0QKUldROUtQK0ZYeCtYTFZRRVdSZitub0I2Y05Uc1RUMjVNcExhYlZ4TCtsUm9ZZ3NqRC9ZbzJ5Z3MK"
    }
  }
}
